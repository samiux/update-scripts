[Unit]
Description=USB/IP Server (auto-export, hotplug, self-healing)
Documentation=man:usbipd(8) man:usbip(8)
After=network-online.target
Wants=network-online.target
Conflicts=usbipd.service

[Service]
Type=notify
NotifyAccess=main
Environment=USBIP_SERVER_CONF=/etc/usbip/usbip-server.conf
ExecStart=/usr/bin/usbip-server.sh
ExecStop=/usr/bin/usbip-server-stop.sh
ExecStopPost=/usr/bin/usbip-server-poststop.sh
Restart=always
RestartSec=3
WatchdogSec=30
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
Nice=-5

[Install]
WantedBy=multi-user.target
